{
  "name": "mr-robot-by-tanzir",
  "version": "1.1.14",
  "description": "Mr.Robot by Tanzir — multi-provider AI chat app with a free no-key default",
  "main": "server.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node server.js",
    "serve": "python -m http.server 3000",
    "check:versions": "node scripts/check-versions.js",
    "build": "node scripts/check-versions.js && rollup -c",
    "bundle": "rollup -c && node server.js",
    "optimize": "rollup -c"
  },
  "keywords": [
    "ai",
    "chat",
    "multi-provider",
    "bengali",
    "puter",
    "free-ai"
  ],
  "license": "MIT",
  "devDependencies": {
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "rollup": "^2.80.0",
    "rollup-plugin-copy": "^3.5.0",
    "rollup-plugin-terser": "^7.0.2"
  }
}
