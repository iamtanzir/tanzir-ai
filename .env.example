# Mr.Robot by Tanzir — cloud "Learn" sync (optional)
#
# Copy this file to `.env` for local development, or add the same variables in
# Vercel → Project → Settings → Environment Variables. With none of them set,
# the app still works: corrections stay in IndexedDB on the device.

# --- Option 1: Turso / libSQL (preferred) ---------------------------------
# Create a database at https://turso.tech, then:
#   turso db shell <db-name> < db/turso-schema.sql
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# --- Option 2: Supabase Postgres (fallback) -------------------------------
# Run supabase/schema.sql in the Supabase SQL editor first.
# Use the service-role key ONLY in server environment variables, never in the
# browser or a public repo.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Local-only testing ----------------------------------------------------
# In-memory store inside the Node process (no database needed). Never use this
# on Vercel: serverless instances are ephemeral and not shared.
# LEARN_DEV=1
